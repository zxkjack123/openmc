<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1">
      <density value="7.87" units="g/cc"/>
      <nuclide name="Fe56" ao="1.0"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="1 -2 -3" universe="1"/>
    <surface id="1" type="z-plane" boundary="vacuum" coeffs="-5.0"/>
    <surface id="2" type="z-plane" boundary="vacuum" coeffs="100.0"/>
    <surface id="3" type="z-cylinder" boundary="vacuum" coeffs="0.0 0.0 50.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>1000</particles>
    <batches>5</batches>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="point">
        <parameters>0 0 0</parameters>
      </space>
      <energy type="discrete">
        <parameters>2000000.0 1.0</parameters>
      </energy>
    </source>
  </settings>
  <tallies>
    <filter id="1" type="point">
      <bins>0 0 10 1.0 0 0 30 1.0 0 0 50 1.0</bins>
    </filter>
    <tally id="1" name="multi_point_detector">
      <filters>1</filters>
      <scores>flux</scores>
    </tally>
  </tallies>
</model>
